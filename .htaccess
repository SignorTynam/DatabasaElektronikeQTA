DirectoryIndex app/pages/index.php

ErrorDocument 400 /DatabasaElektronike/400.html
ErrorDocument 401 /DatabasaElektronike/401.html
ErrorDocument 403 /DatabasaElektronike/403.html
ErrorDocument 404 /DatabasaElektronike/404.html
ErrorDocument 500 /DatabasaElektronike/500.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /DatabasaElektronike/

# Keep existing files/directories as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Legacy URL compatibility: pages/actions/exports moved under app/
RewriteCond %{DOCUMENT_ROOT}/DatabasaElektronike/app/pages/$1.php -f
RewriteRule ^([A-Za-z0-9_-]+)\.php$ app/pages/$1.php [L,QSA,NC]

RewriteCond %{DOCUMENT_ROOT}/DatabasaElektronike/app/actions/$1.php -f
RewriteRule ^([A-Za-z0-9_-]+)\.php$ app/actions/$1.php [L,QSA,NC]

RewriteCond %{DOCUMENT_ROOT}/DatabasaElektronike/app/exports/$1.php -f
RewriteRule ^([A-Za-z0-9_-]+)\.php$ app/exports/$1.php [L,QSA,NC]
</IfModule>
